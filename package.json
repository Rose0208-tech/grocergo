{
  "name": "grocergo-platform",
  "version": "1.0.0",
  "private": true,
  "description": "GrocerGo — Complete Professional Full-Stack Grocery Platform for India",
  "scripts": {
    "install:all": "npm run install:backend && npm run install:customer && npm run install:admin",
    "install:backend": "npm --prefix backend install",
    "install:customer": "npm --prefix customer-frontend install",
    "install:admin": "npm --prefix admin-frontend install",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:customer": "npm --prefix customer-frontend run dev",
    "dev:admin": "npm --prefix admin-frontend run dev",
    "build": "npm --prefix customer-frontend run build && npm --prefix backend run build",
    "start": "node backend/dist/server.js",
    "build:backend": "npm --prefix backend run build",
    "build:customer": "npm --prefix customer-frontend run build",
    "build:admin": "npm --prefix admin-frontend run build",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e"
  },
  "keywords": ["grocergo", "ecommerce", "grocery", "multilingual", "voice-assistant", "upi-qr"],
  "author": "GrocerGo Team",
  "license": "ISC"
}
